# WB Cabinet Purchases — environment variables
#
# Setup:
#   cp .env.example .env
#   chmod 600 .env
#   $EDITOR .env  # заполни секреты
#
# ⚠ .env должен быть в .gitignore (никогда не коммить).

# ═══════════════════════════════════════════════════════════════════════════
# 🔑 WB Seller API Personal Token (180 дней)
# ═══════════════════════════════════════════════════════════════════════════
# Получить: seller.wildberries.ru → Профиль (правый верх) → Доступ к API
# Scopes (отметь ВСЕ что нужны):
#   ✅ Контент (карточки)
#   ✅ Статистика (orders / sales / stocks)
#   ✅ Аналитика  ⚠️ Jam tier для /api/analytics/v3/sales-funnel
#   ✅ Цены и скидки
#   ✅ Поставки / Маркетплейс
# Срок: 180 дней (максимум). Через 6 месяцев перевыпустить.
WB_API_TOKEN=eyJhbGc...PASTE_FULL_JWT_HERE...

# ═══════════════════════════════════════════════════════════════════════════
# 🔑 MPStats API Token
# ═══════════════════════════════════════════════════════════════════════════
# Получить: mpstats.io → Settings → API → Generate token
# ⚠ Тариф должен включать Analytics v1 endpoint (базовый Start подходит)
# Лимит: ~150 ops/мес. Каждый Discovery run = 3 ops.
MPSTATS_API_TOKEN=mps_REPLACE_ME_xxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════
# 🍪 WB Cabinet Cookies path
# ═══════════════════════════════════════════════════════════════════════════
# Cabinet endpoint (seller-content.wildberries.ru/ns/analytics-api/...) использует
# СЕССИОННЫЕ COOKIES (не Bearer JWT). Импортируется через browser_cookie3:
#   1. Залогинься в Chrome → seller-content.wildberries.ru
#   2. Покликай UI 30 сек (статистика, табы)
#   3. ЗАКРОЙ все вкладки с *.wildberries.ru
#   4. wb-pool setup-cookies
# Файл - pickle (бинарный), приватный. Никогда не коммить.
WB_CABINET_COOKIES_PATH=./data/cabinet_cookies.pkl

# Если Chrome Profile НЕ "Default" — укажи путь к Cookies файлу явно:
# CHROME_COOKIE_FILE=~/Library/Application Support/Google/Chrome/Profile 1/Cookies

# ═══════════════════════════════════════════════════════════════════════════
# 💾 Database URL
# ═══════════════════════════════════════════════════════════════════════════
# SQLite (default) — для local / single-user / категории до ~10
# PostgreSQL — для production scale, multiple categories, concurrent runs
DATABASE_URL=sqlite+aiosqlite:///./data/wb-pool.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/wbpool

# ═══════════════════════════════════════════════════════════════════════════
# 🏷 Brand markers — для фильтра keywords в Worker 2 (narrow SERP)
# ═══════════════════════════════════════════════════════════════════════════
# Comma-separated, lowercase. Включи ВСЕ варианты написания твоего бренда:
#   - Латиница ("nivea")
#   - Кириллица ("нивея")
#   - С/без пробелов / дефисов / точек
# Цель: чтобы Worker 2 НЕ извлекал keywords которые включают твой бренд
# (e.g. "nivea крем" — это твой бренд, не категория конкурентов).
MY_BRAND_MARKERS=mybrand,моёназвание

# Примеры:
# MY_BRAND_MARKERS=nivea,нивея         # одна транслитерация
# MY_BRAND_MARKERS=lush,лаш,лаш cosmetics,lush cosmetics  # вариации

# ═══════════════════════════════════════════════════════════════════════════
# 📂 MPStats parent_category
# ═══════════════════════════════════════════════════════════════════════════
# MPStats группирует subject_id под верхнюю категорию. Зависит от твоего subject:
#   "Красота"     для cosmetics (Кремы, Шампуни, Парфюмы, Маски)
#   "Одежда"      для одежды
#   "Электроника" для гаджетов
#   "Детям"       для детских товаров
#   "Книги"       для книг
#   "Спорт"       для спорттоваров
# Найти точное имя: mpstats.io → Categories tree → твой subject → путь сверху
# ⚠ Case-sensitive! "красота" (lowercase) НЕ работает.
MPSTATS_PARENT_CATEGORY=Красота

# ═══════════════════════════════════════════════════════════════════════════
# 📋 Logging
# ═══════════════════════════════════════════════════════════════════════════
# LOG_LEVEL: DEBUG / INFO / WARNING / ERROR
# LOG_JSON=true — production structured JSON (для ELK / filebeat / Grafana)
# LOG_JSON=false — development color console output
LOG_LEVEL=INFO
LOG_JSON=false
LOG_FILE_PATH=./data/logs/wb-pool.jsonl

# ═══════════════════════════════════════════════════════════════════════════
# 🔧 Опциональные тюнинг параметры (защёлкаются в Algorithm I config defaults)
# ═══════════════════════════════════════════════════════════════════════════
# DISCOVERY_SERP_TOP=100              # глубина Layer A SERP main
# DISCOVERY_FEEDBACKS_THRESHOLD=300   # минимум отзывов per layer
# DISCOVERY_N_MY_CARDS=20             # сколько моих brать как seed для narrow keywords
# CABINET_PERIOD_DAYS=90              # период cabinet comparison (typical 90)
